  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "30 d\xE9cembre 2070\n\r\nLes d\xE9tenus du centre de d\xE9tention de Montr\xE9al
    se sont \xE9vad\xE9s apr\xE8s une attaque men\xE9e par un troupeau d'humains
    modifi\xE9s. Le principal scientifique ayant travaill\xE9 sur le programme de
    modification g\xE9n\xE9tique \xAB meilleurs g\xE8nes \xBB est la cible principale
    des autorit\xE9s. Nous pensons qu\u2019il a subit une grave blessure \xE0 la
    t\xEAte, alors nous esp\xE9rons qu'il n'ira pas loin avant d'\xEAtre arr\xEAt\xE9
    par les autorit\xE9s. \xC0 pr\xE9sent, la plupart des grandes villes de la c\xF4te
    est du Canada et des \xC9tats-Unis sont compl\xE8tement envahies par ces cr\xE9atures,
    et le nombre des victimes d\xE9passe d\xE9sormais les dix mille morts. Tous les
    vols \xE0 destination et en provenance d'Am\xE9rique du Nord ont \xE9t\xE9 annul\xE9s
    ; les autorit\xE9s recommandent donc aux personnes se trouvant \xE0 proximit\xE9
    des villes envahies de se d\xE9placer vers l'ouest.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
