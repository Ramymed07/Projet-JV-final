  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "6 mai 2070\n\r\nLes r\xE9serves d'eau et de nourriture s'\xE9puisent,
    le Parlement est tomb\xE9 et beaucoup n'ont pas surv\xE9cu \xE0 l'hiver d\xFB
    au manque de nourriture et d'abri. Docteur Heinz, le scientifique en chef responsable
    du quasi-extermination de la population du Qu\xE9bec et dont le r\xE8gne de terreur
    continue de s'\xE9tendre, est toujours en fuite. Heinz, si vous lisez ceci, sachez
    que vous \xEAtes responsable de tout ce qui s\u2019est pass\xE9e.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
